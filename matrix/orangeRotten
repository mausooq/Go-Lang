type Point struct {
	x, y int
}

func orangesRotting(grid [][]int) int {
    directions := []Point{
		{-1, 0}, 
		{1, 0},  
		{0, -1}, 
		{0, 1},  
	}
    row := len(grid)
    col := len(grid[0])
     queue := []Point{}
     fresh := 0
    for i := 0 ; i < row ; i++{
        for j := 0; j < col ; j++{
            if grid[i][j] == 2 {
                queue = append(queue,Point{i,j})
            } else if grid[i][j] == 1{
                fresh++
            }
        }
    }
    time := 0
    for len(queue) > 0{
        size := len(queue)
        newRotten := false
        for i :=0 ;i < size ; i++{
        curr := queue[0]
        queue = queue[1:]
        
        for _ , dir := range directions{
            newR , newC := curr.x+dir.x , curr.y+dir.y
             if newR >= 0 && newC >= 0 &&  newR < row && newC < col && grid[newR][newC] == 1 {
                 grid[newR][newC] = 2
                queue = append(queue,Point{newR,newC})
                fresh--
                newRotten = true
             }
           }
        }
        if newRotten{
             time++
        }
    }
    if fresh > 0 {
		return -1
    }
    return time
}