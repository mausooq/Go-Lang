func numIslands(grid [][]byte) int {
    cnt := 0
    row := len(grid)
    col := len(grid[0])
    for i := 0 ; i < row ; i++{
        for j :=0 ; j < col ; j++{
            if grid[i][j] == '1' {
                dfs(grid,row,col,i,j)
                cnt++
            }
        }
    }
    return cnt
}

func dfs(grid [][]byte,row,col,i,j int){
    
    if i < 0 || j < 0 || i >= row || j >= col || grid[i][j] != '1'{
        return 
    }

    grid[i][j] = '2'

    dfs(grid,row,col,i-1,j)
    dfs(grid,row,col,i+1,j)
    dfs(grid,row,col,i,j-1)
    dfs(grid,row,col,i,j+1)

}
