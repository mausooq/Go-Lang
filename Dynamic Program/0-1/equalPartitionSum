package main
import "fmt"

func subsetSum(arr []int, n int, target int) bool {
	
	dp := make([][]bool, n+1)
	for i := range dp {
		dp[i] = make([]bool, target+1)
	}

	
	for i := 0; i <= n; i++ {
		dp[i][0] = true
	}


	for i := 1; i <= n; i++ {
		for j := 1; j <= target; j++ {
			if arr[i-1] > j {
				dp[i][j] = dp[i-1][j] 
			} else {
				dp[i][j] = dp[i-1][j] || dp[i-1][j-arr[i-1]] 
			}
		}
	}


	return dp[n][target]
}

func part( arr []int, n int) bool {
    sum:=0
     for _, val := range arr{
        sum+=val
    }
    if sum % 2 != 0{
        return false
    }
    target := sum/2
  
   
 
    return subsetSum(arr,n,target)
   
}


func main() {
    arr := []int{1,5,5,11}
  
   
    fmt.Println(part(arr,len(arr)))
}