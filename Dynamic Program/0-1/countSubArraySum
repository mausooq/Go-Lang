package main
import "fmt"


func count(arr []int , n int ,target int) int {
    dp := make([][]int , n+1)
    for i := range dp {
        dp[i] = make([]int , target+1)
    }
    for i :=0 ; i <=n ; i++{
        dp[i][0] = 1
    }
    for i := 1 ; i <= n ; i++{
        for j :=1 ; j <= target ; j++{
            if arr[i-1] > j {
                dp[i][j] = dp[i-1][j]
            } else {
                dp[i][j] = dp[i-1][j] + dp[i-1][j-arr[i-1]]
            }
        }
    }
    for _,row := range dp{
        fmt.Println(row)
    }
    return dp[n][target]
}

func main() {
    arr := []int{2, 3, 5, 6, 8, 10}
  
   

fmt.Println(count(arr,len(arr),10))
    
}