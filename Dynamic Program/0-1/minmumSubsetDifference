package main
import "fmt"
import "math"


func count(arr []int , n int ) int {
   
    totalSum := 0 
    for _,val := range arr {
        totalSum += val
    }
    target := totalSum/2
    
     dp := make([][]bool , n+1)
    for i := range dp {
        dp[i] = make([]bool , target+1)
    }
    for i :=0 ; i <=n ; i++{
        dp[i][0] = true
    }
    
    
    for i := 1 ; i <= n ; i++{
        for j :=1 ; j <= target ; j++{
            if arr[i-1] > j {
                dp[i][j] = dp[i-1][j]
            } else {
                dp[i][j] = dp[i-1][j] || dp[i-1][j-arr[i-1]]
            }
        }
    }
    
    s1 := 0 
    for j := target ; j >=0 ; j--{
        if dp[n][j]{
            s1 = j
            break
        }
    }
    
    
    return int(math.Abs(float64(totalSum - 2*s1)))
}

func main() {
    arr := []int{1, 2, 7}
  
   

fmt.Println(count(arr,len(arr)))
    
}