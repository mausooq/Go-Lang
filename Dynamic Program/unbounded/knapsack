// Online Go compiler to run Golang program online
// Print "Try programiz.pro" message

package main
import "fmt"

func main() {
  fmt.Println("Try programiz.pro")
  weight := []int{1,3,4}
  value := []int{10,40,50}
  W := 6
  
  fmt.Println(knapsack(weight,value,len(weight),W))
}

func knapsack(weight []int , value []int , n int , W int)int{
    dp := make([][]int, n+1)
    for i := range dp {
        dp[i] = make([]int ,W+1 )
    }
    
    for i := 1 ; i <= n ; i++{
        for j :=0 ; j <=W ; j++{
            if weight[i-1] > j {
                dp[i][j] = dp[i-1][j]
            } else {
                dp[i][j] = max(value[i-1]+dp[i][j-weight[i-1]],dp[i-1][j])
            }
        }
    }
    return dp[n][W]
    
}
func max(a,b int)int {
    if a > b {
        return a
    }
    return b
}

