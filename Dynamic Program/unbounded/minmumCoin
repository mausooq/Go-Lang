func coinChange(coins []int, amount int) int {
    n := len(coins)
    dp := make([][]int , n+1)
    for i := range dp{
        dp[i] = make([]int, amount+1)
    }
    for i := 0 ; i <= amount ; i++{
        dp[0][i] = math.MaxInt32 - 1
       
    }
    
    for i := 1 ; i <= n ; i++{
        for j := 1 ; j <= amount ; j++{
            if coins[i-1] > j {
                dp[i][j] = dp[i-1][j]
            } else {
                dp[i][j] = min(1+dp[i][j-coins[i-1]],dp[i-1][j])
            }
        }
    }
    if dp[n][amount] == math.MaxInt32-1 {
		return -1
	}


    return dp[n][amount]
}
