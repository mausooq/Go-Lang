package main
import "fmt"

func reverse(a string)string{
    runes := []rune(a)
    n := len(a)
    for i := 0 ; i < n/2 ; i++{
        runes[i] , runes[n-i-1] = runes[n-i-1],runes[i]
    }
    return string(runes)
}

func minDel(a string) int {
    b := reverse(a)
    
    n := len(a)
    m := len(b)
    
    dp := make([][]int,n+1)
    for i := range dp{
        dp[i] = make([]int,m+1)
    }
    for i := 1 ; i <= n ; i++{
        for j := 1 ; j <=m ; j++{
            if a[i-1] == b[j-1]{
                dp[i][j] = 1 + dp[i-1][j-1]
            } else {
                dp[i][j] = max(dp[i-1][j],dp[i][j-1])
            }
        }
    }
    
    return len(a)-dp[n][m]
}


func main(){
    a := "agbcba"
    
    fmt.Println(minDel(a))
    
    
}



