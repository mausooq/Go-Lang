package main

import (
	"fmt"
)
func minmumNoOfInsertionAndDeletion(s1 string,s2 string) (int,int){
    n := len(s1)
    m := len(s2)
    dp := make([][]int, n+1)
    for i := range dp{
        dp[i] = make([]int,m+1)
    }
    for i := 1 ; i <= n ; i++{
        for j := 1 ; j <= m ; j++{
            if s1[i-1] == s2[j-1]{
                dp[i][j] = 1+dp[i-1][j-1]
            } else {
                dp[i][j] = max(dp[i-1][j] , dp[i][j-1])
            }
        }
    }
    insertion := m - dp[n][m]
    deletion := n - dp[n][m]
    return insertion,deletion
}



func max(a, b int) int {
	if a > b {
		return a
	}
	return b
}

func main() {
	str1 := "HEAP"
	str2 := "PEA"
insertion, deletion := minmumNoOfInsertionAndDeletion(str1, str2) // Unpack the two values here
	fmt.Printf("Insertions: %d, Deletions: %d\n", insertion, deletion)
	
}
