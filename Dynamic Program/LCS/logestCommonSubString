package main
import "fmt"
func lcs(text1 string, text2 string) int {
    n := len(text1)
    m := len(text2)
    dp := make([][]int,n+1)
    for i := range dp {
        dp[i] = make([]int,m+1)
    }
    maxLen:= 0
    for i := 1 ; i <= n ; i++{
        for j := 1 ; j <= m ; j++{
            if text1[i-1] == text2[j-1]{
                dp[i][j] = 1 + dp[i-1][j-1]
                maxLen = max(maxLen,dp[i][j])
            } else {
                dp[i][j] = 0
            }
        }
    }
    return maxLen
}
func max(a,b int) int {
    if a > b {
        return a
    }
    return b
}

func main() {
    X := "xyzabcd"
    Y := "abcdxyz"
    fmt.Println(lcs(X,Y))
}