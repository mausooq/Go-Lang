package main
import "fmt"

func minReorder(n int,connections [][]int) int {
    forward := make(map[int][]int)
    backward := make(map[int][]int)
    for _, row := range connections{
        forward[row[0]] = append(forward[row[0]],row[1])
        backward[row[1]] = append(backward[row[1]],row[0])
    }
    // fmt.Println(forward,backward)
    cnt:=0
    visited := make([]bool,n)
    var DFS func(src int)
    DFS = func(src int){
        visited[src] = true
        for _,val := range forward[src]{
            if !visited[val]{
                cnt++
                DFS(val)
            } 
        }
        
        for _,val := range backward[src]{
            DFS(val)   
        }
    }
    
    DFS(0)
    
    return cnt
}


func main() {
    n := 6
    connections := [][]int{
        {0, 1}, {1, 3}, {2, 3}, {4, 0}, {4, 5},
    }

    result := minReorder(n, connections)
    fmt.Printf("Minimum edges to reorder: %d\n", result)
}